# CHANGE THIS: unique Docker Compose project name for this site.
# Use the same value as the directory name, for example site2 or company-blog.
COMPOSE_PROJECT_NAME=site_name

# CHANGE THIS: public temporary HTTP port while the site has no domain.
# Use a different port for every site: 8081, 8082, 8083, ...
WORDPRESS_PORT=8082

# Usually can stay unchanged unless you want a custom DB name.
MYSQL_DATABASE=wordpress

# Usually can stay unchanged unless you want a custom DB user.
MYSQL_USER=wp_user

# CHANGE THIS: unique strong password for this site's WordPress DB user.
MYSQL_PASSWORD=change_this_strong_password

# CHANGE THIS: unique strong MariaDB root password for this site.
MYSQL_ROOT_PASSWORD=change_this_root_password

# Usually can stay unchanged for a separate database per site.
WORDPRESS_TABLE_PREFIX=wp_

# Keep 0 for normal use. Set 1 only for debugging.
WORDPRESS_DEBUG=0
