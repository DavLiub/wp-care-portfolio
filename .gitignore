# Secrets
.env
credentials.private.txt

# Database
db/

# WordPress core copied into bind mount by the official image
index.php
license.txt
readme.html
wp-*.php
xmlrpc.php
wp-admin/
wp-includes/

# WordPress generated/user content
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backup*/
wp-content/backups/

# Default bundled plugins/themes can be reinstalled from WordPress
wp-content/plugins/
# Ignore installed themes
wp-content/themes/*

# Keep the customized child theme
!wp-content/themes/caresoft/
!wp-content/themes/caresoft/**

# WordPress downloaded/generated fonts
wp-content/fonts/

# Keep wp-content folder placeholder if added later
!wp-content/.gitkeep

# Logs and DB runtime files
*.log
aria_log*
ib_*
ibtmp*
ibdata*
tc.log
undo*
multi-master.info
*.pid
*.sock

# Backups and dumps
backups/
*.sql
*.sql.gz
*.tar
*.tar.gz
*.zip

